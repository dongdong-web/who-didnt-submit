# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- PyInstaller ----
# build*/ dist*/ 用通配是因为打过多次包（build_onefile / dist_onefile 之类），
# 只写 build/ dist/ 会漏掉它们。
build*/
dist*/
*.spec

# ---- 打包好的成品 ----
# exe 十几 MB，是分发给用户的东西，不该进代码仓库。
*.exe

# ---- PyInstaller onefile 的运行时解压目录 ----
# 因为用了 --runtime-tmpdir .，bootloader 会把整个运行时解压到「当前目录」。
# 正常退出会自己删，但被强杀（或崩溃）就会留下，里面是几千个文件。
# 不加这条的话 git add -A 会把它整个吞进去 —— 已经栽过一次了。
_MEI*/

# ---- 自测产物 ----
# --noconsole 打包后看不到 stdout，自测结果会写成文件，别提交进来
谁没交_selftest.txt
谁没交_droptest.txt
谁没交_crash.txt

# ---- 一次性探针 ----
# 排查问题时随手写的小脚本，不留在仓库里
_*.py
!__init__.py
_*.png

# ---- 模拟数据 ----
# 138 个文件全由 make_sample_data.py 生成，需要就先跑一遍：
#   python make_sample_data.py
模拟数据/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
